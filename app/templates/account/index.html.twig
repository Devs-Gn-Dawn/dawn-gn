                                       href="javascript:;">Modifier</a>
                                    <div class="h-4 mx-1 bg-slate-300 w-px"></div>
                                    <a onclick="deleteAllergy({{ allergy.id }})"
                                       class="inline-block pl-4 mb-0 ml-0 font-bold text-center align-middle transition-all bg-transparent border-0 shadow-none cursor-pointer leading-pro text-xs ease-soft-in text-slate-400 hover:text-red-600 hover:underline"
                                       href="javascript:;">Supprimer</a>
                                </li>
                            {% endfor %}
                            <li class="relative flex items-center px-0 py-2 bg-white border-0 rounded-t-lg">
                                <div class="w-full mx-2 p-1 text-center justify-center bg-slate-100 bg-opacity-40 border rounded border-dashed border-slate-300 hover:border-solid">
                                    <span onclick="openAllergyModal()" class="text-xs font-semibold leading-tight text-slate-500 cursor-pointer hover:scale-102 hover:text-slate-900 hover:underline"><strong class="font-extrabold">+ </strong>Ajouter une allergie</span>
                                </div>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>

