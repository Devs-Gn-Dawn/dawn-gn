                  <li class="relative block px-4 py-2 pt-0 pl-0 leading-normal bg-white border-0 rounded-t-lg text-sm text-inherit"><strong class="text-slate-700">Nom :</strong> &nbsp; {{ user.name }}</li>
                  <li class="relative block px-4 py-2 pl-0 leading-normal bg-white border-0 rounded-t-lg text-sm text-inherit"><strong class="text-slate-700">Prénom :</strong> &nbsp; {{ user.firstname }}</li>
                  <li class="relative block px-4 py-2 pl-0 leading-normal bg-white border-0 border-t-0 text-sm text-inherit"><strong class="text-slate-700">Téléphone :</strong> &nbsp; {{ user.phone }}</li>
                  <li class="relative block px-4 py-2 pl-0 leading-normal bg-white border-0 border-t-0 text-sm text-inherit">
                <a onclick="editProfile()" href="#"class="text-slate-700" data-target="tooltip_trigger" data-placement="top">
                    <strong class="font-extrabold">Droit à l'image : </strong><span>J'autorise / Je n'autorise pas</span>&nbsp;
                  </a> 
                  <div data-target="tooltip" class="hidden px-2 py-1 text-center text-white bg-slate-700 rounded-lg text-sm" role="tooltip">
                                J'autorise / Je n'autorise pas l’utilisation, la diffusion, la publication ou la reproduction des photographies et des vidéos prises lors des différents évènements Dawn.
                                <div class="invisible absolute h-2 w-2 bg-inherit before:visible before:absolute before:h-2 before:w-2 before:rotate-45 before:bg-inherit before:content-['']" data-popper-arrow></div>
                            </div>
                  </li>
                  {# <li class="relative block px-4 py-2 pb-0 pl-0 bg-white border-0 border-t-0 rounded-b-lg text-inherit">
                    <strong class="leading-normal text-sm text-slate-700">Social:</strong> &nbsp;
                    {% if user.social %}
                    <a class="inline-block py-0 pl-1 pr-2 mb-0 font-bold text-center text-blue-800 align-middle transition-all bg-transparent border-0 rounded-lg shadow-none cursor-pointer leading-pro text-xs ease-soft-in bg-none" href="javascript:;">
                      <i class="fab fa-facebook fa-lg"></i>
                    </a>
                    {% endif %}
                  </li> #}
                </ul>
              </div>
              <div class="p-4 pb-0 mb-0 bg-white border-b-0 rounded-t-2xl">
                <div class="flex flex-wrap -mx-3">
                  <div class="flex items-center w-full max-w-full px-3 shrink-0 md:w-8/12 md:flex-none">
                    <h6 class="mb-0">Mes informations de connexion</h6>
                  </div>
                  <div class="w-full max-w-full px-3 text-right shrink-0 md:w-4/12 md:flex-none">
                    <a onclick="editLoginInfo()" href="javascript:;" data-target="tooltip_trigger" data-placement="top">
                      <i class="leading-normal fas fa-user-edit text-sm text-slate-400 hover:text-slate-700"></i>
                    </a>
                    <div data-target="tooltip" class="hidden px-2 py-1 text-center text-white bg-slate-700 rounded-lg text-sm z-10" role="tooltip">
                      Modifier le login et/ou le mot de passe
                      <div class="invisible absolute h-2 w-2 bg-inherit before:visible before:absolute before:h-2 before:w-2 before:rotate-45 before:bg-inherit before:content-[''] z-10" data-popper-arrow></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="flex-auto p-4">
                <hr class="h-px my-2 bg-transparent bg-gradient-to-r from-transparent via-white to-transparent" />
                <ul class="flex flex-col pl-0 mb-0 rounded-lg">
                  <li class="relative block px-4 py-2 pl-0 leading-normal bg-white border-0 border-t-0 text-sm text-inherit"><strong class="text-slate-700">Email / Login :</strong> &nbsp; {{ user.email }}</li>
                  <li class="relative block px-4 py-2 pl-0 leading-normal bg-white border-0 border-t-0 text-sm text-inherit"><strong class="text-slate-700">Mot de passe :</strong> &nbsp; ***********</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="w-full max-w-full px-3 lg-max:mt-6 xl:w-4/12">
            <div class="relative flex flex-col h-full min-w-0 break-words bg-white border-0 shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-4 pb-0 mb-0 bg-white border-b-0 rounded-t-2xl">
                    <h6 class="mb-0">Bloc notes</h6>
                </div>
                <div class="flex-auto p-4">
                    <ul class="flex flex-col pl-0 mb-0 rounded-lg">
                        {% if user.notes is empty %}
                            <li class="relative flex items-center px-0 py-2 bg-white border-0 rounded-t-lg text-inherit">
                                <div class="w-full mx-2 p-1 text-center justify-center bg-slate-100 bg-opacity-40 border rounded border-dashed border-slate-300 hover:border-solid">
                                    <span onclick="openNoteModal()" class="text-xs font-semibold leading-tight text-slate-500 cursor-pointer hover:scale-102 hover:text-slate-900 hover:underline"><strong class="font-extrabold">+ </strong>Ajouter une note</span>
                                </div>
                            </li>
                        {% else %}
                            {% for note in user.notes %}
                                <li class="relative flex items-center px-0 py-2 bg-white border-0 rounded-t-lg text-inherit">
                                    <div class="flex flex-col items-start justify-center w-full">
                                        <h6 class="mb-0 leading-normal text-sm font-bold">{{ note.title }}</h6>
                                        <p class="mb-0 leading-normal text-sm">
                                            <span class="whitespace-pre-line break-words">{{ note.content|length > 100 ? note.content|slice(0, 100) ~ '...' : note.content }}</span>
                                            {% if note.content|length > 100 %}
                                                <a onclick="viewFullNote('{{ note.title|e('js') }}', `{{ note.content|e('js') }}`)"
                                                   class="inline-block ml-1 text-xs font-semibold text-slate-400 hover:text-slate-700 hover:underline cursor-pointer">
                                                    Voir plus
                                                </a>
                                            {% endif %}
                                        </p>
                                    </div>
                                    <div class="flex items-center ml-auto">
                                        <a onclick="editNote({{ note.id }}, '{{ note.title|e('js') }}', `{{ note.content|e('js') }}`)"
                                           class="inline-block pl-0 pr-4 mb-0 font-bold text-center align-middle transition-all bg-transparent border-0 rounded-lg shadow-none cursor-pointer leading-pro text-xs ease-soft-in text-slate-400 hover:text-slate-900 hover:underline" 
                                           href="javascript:;">Modifier</a>
                                        <div class="h-4 mx-1 bg-slate-300 w-px"></div>
                                        <a onclick="deleteNote({{ note.id }})"
                                           class="inline-block pl-4 mb-0 font-bold text-center align-middle transition-all bg-transparent border-0 shadow-none cursor-pointer leading-pro text-xs ease-soft-in text-slate-400 hover:text-red-600 hover:underline" 
                                           href="javascript:;">Supprimer</a>
                                    </div>
                                </li>
                            {% endfor %}
