{% extends 'base.html.twig' %}

{% block title %}Mes informations - Dawn GN{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Les fonctions showSuccessAlert et showErrorAlert ont été déplacées dans app.js
            
            // Fonction pour tronquer le texte
            function truncateText(text, maxLength = 100) {
                if (text.length <= maxLength) return text;
                return text.substr(0, maxLength) + '...';
            }

            // Fonction pour afficher la note complète
            window.viewFullNote = function(title, content) {
                // Convertir les retours à la ligne en <br>
                const formattedContent = content.replace(/\n/g, '<br>');
                
                Swal.fire({
                    title: title,
                    html: `<div class="text-left break-words p-4 text-sm">${formattedContent}</div>`,
                    confirmButtonText: 'Fermer',
                    customClass: {
                        confirmButton: window.BUTTON_CLASSES.primary,
                        htmlContainer: 'max-h-[60vh] overflow-y-auto',
                        popup: 'w-[32rem]'
                    },
                    showClass: {
                        popup: 'animate__animated animate__fadeIn'
                    },
                    hideClass: {
                        popup: 'animate__animated animate__fadeOut'
                    }
                });
            };

            // Exemple d'utilisation pour les contacts d'urgence
            window.openEmergencyContactModal = function() {
                createModal({
                    title: 'Ajouter un contact d\'urgence',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="emergency-contact-name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Nom du contact" required>
                        </div>
                        <div class="mb-4">
                            <input type="tel" id="emergency-contact-phone" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Numéro de téléphone" required>
                        </div>
                    `,
                    getData: () => ({
                        name: document.getElementById('emergency-contact-name').value,
                        phone: document.getElementById('emergency-contact-phone').value
                    }),
                    validate: (data) => data.name && data.phone,
                    url: '{{ path('app_account_emergency_contact_add') }}',
                    successTitle: 'Contact ajouté !',
                    successMessage: 'Le contact d\'urgence a été ajouté avec succès.'
                });
            };

            window.editEmergencyContact = function(id, name, phone) {
                Swal.fire({
                    title: 'Modifier le contact d\'urgence',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="emergency-contact-name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Nom du contact" required>
                        </div>
                        <div class="mb-4">
                            <input type="tel" id="emergency-contact-phone" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Numéro de téléphone" required>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Modifier',
                    cancelButtonText: 'Annuler',
                    customClass: window.modalClasses,
                    didOpen: () => {
                        document.getElementById('emergency-contact-name').value = name;
                        document.getElementById('emergency-contact-phone').value = phone;
                    },
                    preConfirm: () => {
                        const name = document.getElementById('emergency-contact-name').value;
                        const phone = document.getElementById('emergency-contact-phone').value;
                        
                        if (!name || !phone) {
                            Swal.showValidationMessage('Veuillez remplir tous les champs');
                            return false;
                        }
                        
                        return fetch(`{{ path('app_account_emergency_contact_edit', {'id': 'CONTACT_ID'}) }}`.replace('CONTACT_ID', id), {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                name: name,
                                phone: phone
                            })
                        })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Une erreur est survenue');
                            }
                            return response.json();
                        })
                        .catch(error => {
                            Swal.showValidationMessage(error.message);
                        });
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        showSuccessAlert('Contact modifié !', 'Le contact d\'urgence a été modifié avec succès.');
                    }
                });
            };

            window.deleteEmergencyContact = function(id) {
                confirmDelete(`{{ path('app_account_emergency_contact_delete', {'id': 'CONTACT_ID'}) }}`.replace('CONTACT_ID', id));
            };

            // Allergies
            window.openAllergyModal = function() {
                createModal({
                    title: 'Ajouter une allergie',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="allergy-name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Nom de l'allergie" required>
                        </div>
                    `,
                    getData: () => ({
                        name: document.getElementById('allergy-name').value
                    }),
                    validate: (data) => data.name,
                    url: '{{ path('app_account_allergy_add') }}',
                    successTitle: 'Allergie ajoutée !',
                    successMessage: 'L\'allergie a été ajoutée avec succès.'
                });
            };

            window.editAllergy = function(id, name) {
                createModal({
                    title: 'Modifier l\'allergie',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="allergy-name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Nom de l'allergie" required>
                        </div>
                    `,
                    confirmButtonText: 'Modifier',
                    getData: () => ({
                        name: document.getElementById('allergy-name').value
                    }),
                    validate: (data) => data.name,
                    url: `{{ path('app_account_allergy_edit', {'id': 'ALLERGY_ID'}) }}`.replace('ALLERGY_ID', id),
                    didOpen: () => {
                        document.getElementById('allergy-name').value = name;
                    },
                    successTitle: 'Allergie modifiée !',
                    successMessage: 'L\'allergie a été modifiée avec succès.'
                });
            };

            window.deleteAllergy = function(id) {
                confirmDelete(`{{ path('app_account_allergy_delete', {'id': 'ALLERGY_ID'}) }}`.replace('ALLERGY_ID', id));
            };

            // Notes
            window.openNoteModal = function() {
                createModal({
                    title: 'Ajouter une note',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="note-title" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Titre de la note" required>
                        </div>
                        <div class="mb-4">
                            <textarea id="note-content" rows="4" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Contenu de la note" required></textarea>
                        </div>
                    `,
                    getData: () => ({
                        title: document.getElementById('note-title').value,
                        content: document.getElementById('note-content').value
                    }),
                    validate: (data) => data.title && data.content,
                    url: '{{ path('app_account_note_add') }}',
                    successTitle: 'Note ajoutée !',
                    successMessage: 'La note a été ajoutée avec succès.'
                });
            };

            window.editNote = function(id, title, content) {
                createModal({
                    title: 'Modifier la note',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="note-title" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Titre de la note" required>
                        </div>
                        <div class="mb-4">
                            <textarea id="note-content" rows="4" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Contenu de la note" required></textarea>
                        </div>
                    `,
                    confirmButtonText: 'Modifier',
                    getData: () => ({
                        title: document.getElementById('note-title').value,
                        content: document.getElementById('note-content').value
                    }),
                    validate: (data) => data.title && data.content,
                    url: `{{ path('app_account_note_edit', {'id': 'NOTE_ID'}) }}`.replace('NOTE_ID', id),
                    didOpen: () => {
                        document.getElementById('note-title').value = title;
                        document.getElementById('note-content').value = content;
                    },
                    successTitle: 'Note modifiée !',
                    successMessage: 'La note a été modifiée avec succès.'
                });
            };

            window.deleteNote = function(id) {
                confirmDelete(`{{ path('app_account_note_delete', {'id': 'NOTE_ID'}) }}`.replace('NOTE_ID', id));
            };

            // Fonction pour gérer les inscriptions
            window.manageRegistration = function(id = null, ticket = null, currentEvent = null) {
                createModal({
                    title: id ? 'Modifier mon inscription' : 'Nouvelle inscription',
                    html: `
                        <div class="mb-4">
                            <label for="registration-event" class="block text-sm font-medium text-gray-700 mb-1">Type d'événement</label>
                            <select id="registration-event" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" required>
                                <option value="">Sélectionnez un type d'événement</option>
                                {% for label, value in eventTypes %}
                                    <option value="{{ value }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-4">
                            <label for="registration-ticket" class="block text-sm font-medium text-gray-700 mb-1">Numéro de billet HelloAsso</label>
                            <input type="text" id="registration-ticket" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Numéro du billet" required>
                        </div>
                    `,
                    getData: () => ({
                        event: document.getElementById('registration-event').value,
                        ticket: document.getElementById('registration-ticket').value
                    }),
                    validate: (data) => data.event && data.ticket,
                    url: id 
                        ? `{{ path('app_account_registration_edit', {'id': 'REG_ID'}) }}`.replace('REG_ID', id)
                        : '{{ path('app_account_registration_add') }}',
                    didOpen: () => {
                        if (id) {
                            document.getElementById('registration-event').value = currentEvent || '';
                            document.getElementById('registration-ticket').value = ticket || '';
                        }
                    },
                    confirmButtonText: id ? 'Modifier' : 'Ajouter',
                    successTitle: id ? 'Inscription modifiée !' : 'Inscription ajoutée !',
                    successMessage: id 
                        ? 'L\'inscription a été mise à jour avec succès.'
                        : 'La nouvelle inscription a été ajoutée avec succès.'
                });
            };

            window.editProfile = function() {
                createModal({
                    title: 'Modifier mon profil',
                    html: `
                        <div class="mb-4">
                            <input type="text" id="profile-name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Nom" required>
                        </div>
                        <div class="mb-4">
                            <input type="text" id="profile-firstname" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Prénom" required>
                        </div>
                        <div class="mb-4">
                            <input type="tel" id="profile-phone" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Téléphone" required>
                        </div>
                        <div class="mb-4 text-left relative flex items-center">
                            <div class="flex flex-col items-start justify-center mr-4">
                            <input id="follow" class="mt-0.54 rounded-10 duration-250 ease-soft-in-out after:rounded-circle after:shadow-soft-2xl after:duration-250 checked:after:translate-x-5.25 h-5 relative float-left ml-auto w-10 cursor-pointer appearance-none border border-solid border-gray-200 bg-slate-800/10 bg-none bg-contain bg-left bg-no-repeat align-top transition-all after:absolute after:top-px after:h-4 after:w-4 after:translate-x-px after:bg-white after:content-[''] checked:border-slate-800/95 checked:bg-green-700/95 checked:bg-none checked:bg-right" type="checkbox" " />
                            </div>
                            <div class="flex items-center ml-auto w-full text-sm">
                            J'autorise / Je n'autorise pas l’utilisation, la diffusion, la publication ou la reproduction des photographies et des vidéos prises lors des différents évènements Dawn.
                            </div>
                            
                            
                            
                        </div>
                        {# <div class="mb-4">
                            <input type="text" id="profile-social" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Réseaux sociaux">
                        </div> #}
                    `,
                    confirmButtonText: 'Modifier',
                    getData: () => ({
                        name: document.getElementById('profile-name').value,
                        firstname: document.getElementById('profile-firstname').value,
                        phone: document.getElementById('profile-phone').value,
                        social: document.getElementById('profile-social').value
                    }),
                    validate: (data) => data.name && data.firstname && data.phone,
                    url: '{{ path('app_account_profile_edit') }}',
                    didOpen: () => {
                        document.getElementById('profile-name').value = '{{ user.name }}';
                        document.getElementById('profile-firstname').value = '{{ user.firstname }}';
                        document.getElementById('profile-phone').value = '{{ user.phone }}';
                        document.getElementById('profile-social').value = '{{ user.social }}';
                    },
                    successTitle: 'Profil modifié !',
                    successMessage: 'Votre profil a été modifié avec succès.'
                });
            };

            window.editLoginInfo = function() {
                createModal({
                    title: 'Modifier mes informations de connexion',
                    html: `
                        <div class="mb-4">
                            <input type="email" id="login-email" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Email" required>
                        </div>
                        <div class="mb-4">
                            <input type="password" id="login-password" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Nouveau mot de passe">
                        </div>
                        <div class="mb-4">
                            <input type="password" id="login-password-confirm" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Confirmer le mot de passe">
                        </div>
                    `,
                    confirmButtonText: 'Modifier',
                    getData: () => ({
                        email: document.getElementById('login-email').value,
                        password: document.getElementById('login-password').value,
                        password_confirm: document.getElementById('login-password-confirm').value
                    }),
                    validate: (data) => {
                        if (!data.email) return false;
                        if (data.password && data.password !== data.password_confirm) {
                            Swal.showValidationMessage('Les mots de passe ne correspondent pas');
                            return false;
                        }
                        return true;
                    },
                    url: '{{ path('app_account_login_edit') }}',
                    didOpen: () => {
                        document.getElementById('login-email').value = '{{ user.email }}';
                    },
                    successTitle: 'Informations modifiées !',
                    successMessage: 'Vos informations de connexion ont été modifiées avec succès.'
                });
            };
        });
    </script>
{% endblock %}

{% block body %}
<div class="w-full px-6 mx-auto">
    <div class="relative flex flex-col flex-auto min-w-0 p-4 mt-12 overflow-hidden break-words border-0 shadow-blur rounded-2xl bg-white/80 bg-clip-border backdrop-blur-2xl backdrop-saturate-200">
        <div class="flex flex-wrap -mx-3">
            {% if user.hasMainCharacter() %}
            <div class="flex-none w-auto max-w-full px-3">
                <div class="text-base ease-soft-in-out h-18.5 w-18.5 relative inline-flex items-center justify-center rounded-xl text-white transition-all duration-200">
                    <img src="{{ asset('build/images/avatars/' ~ user.getMainCharacter().getAvatar() ~ '.jpg') }}" alt="profile_image" class="w-full shadow-soft-sm rounded-xl" />
                </div>
            </div>
            {% endif %}
            <div class="flex-none w-auto max-w-full px-3 my-auto">
                <div class="h-full">
                    <h5 class="mb-1">{{ user.getFullName() }}</h5>
                    <p class="mb-0 font-semibold leading-normal text-sm"><span class="font-extrabold text-slate-700">{{ user.registrations|filter(r => r.getEventType().status == constant('App\\Entity\\EventType::STATUS_CLOSED'))|length }}</span> participations</p>
                </div>
            </div>
            <div class="w-full max-w-full px-3 mx-auto mt-4 sm:my-auto sm:mr-0 md:w-1/5 md:flex-none">
                <div class="relative right-0">
                    N° de billet <a href="javascript:sweetTicket();" id="info" data-target="tooltip_trigger" data-placement="top"><i class="fa fa-question-circle hover:text-slate-700" aria-hidden="true"></i></a> 
                    <div data-target="tooltip" class="hidden px-2 py-1 text-center text-white bg-slate-700 rounded-lg text-sm" role="tooltip">
                        Plus d'informations
                        <div class="invisible absolute h-2 w-2 bg-inherit before:visible before:absolute before:h-2 before:w-2 before:rotate-45 before:bg-inherit before:content-['']" data-popper-arrow></div>
                    </div>
                    : <span class="font-extrabold text-slate-700">{% if user.lastRegistrationWithState(constant('App\\Entity\\EventType::STATUS_OPEN')) %}{{ user.lastRegistrationWithState(constant('App\\Entity\\EventType::STATUS_OPEN')).helloassoTicket }}{% else %}Non renseigné{% endif %}</span>
                    {% if user.lastRegistrationWithState(constant('App\\Entity\\EventType::STATUS_OPEN')) %}
                    {% set lastRegistration = user.lastRegistrationWithState(constant('App\\Entity\\EventType::STATUS_OPEN')) %}
                    <a href="#" onclick="manageRegistration('{{ lastRegistration ? lastRegistration.id : '' }}',
                    '{{ lastRegistration ? lastRegistration.helloassoTicket : '' }}',
                    '{{ lastRegistration ? lastRegistration.event : '' }}')" data-target="tooltip_trigger" data-placement="top"><i class="ml-2 fa fa-pencil hover:scale-102 hover:text-slate-700"></i></a>
                    <div data-target="tooltip" class="hidden px-2 py-1 text-center text-white bg-slate-700 rounded-lg text-sm" role="tooltip">
                        Editer le numéro du billet
                        <div class="invisible absolute h-2 w-2 bg-inherit before:visible before:absolute before:h-2 before:w-2 before:rotate-45 before:bg-inherit before:content-['']" data-popper-arrow></div>
                    </div>
                    {% endif %}
                    {% if not user.lastRegistrationWithState(constant('App\\Entity\\EventType::STATUS_OPEN')) %}
                    <a href="#" onclick="manageRegistration()" data-target="tooltip_trigger" data-placement="top"><i class="ml-2 fa fa-plus hover:scale-102 hover:text-slate-700"></i></a>
                    <div data-target="tooltip" class="hidden px-2 py-1 text-center text-white bg-slate-700 rounded-lg text-sm" role="tooltip">
                        Ajouter un numéro de billet
                        <div class="invisible absolute h-2 w-2 bg-inherit before:visible before:absolute before:h-2 before:w-2 before:rotate-45 before:bg-inherit before:content-['']" data-popper-arrow></div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="w-full p-6 mx-auto">
    <div class="flex flex-wrap -mx-3">
        <div class="w-full max-w-full px-3 xl:w-4/12">
            <div class="relative flex flex-col h-full min-w-0 break-words bg-white border-0 shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-4 pb-0 mb-0 bg-white border-b-0 rounded-t-2xl">
                    <h6 class="mb-0">Mes informations importantes</h6>
                </div>
                <div class="flex-auto p-4">
                    <h6 class="font-bold leading-tight uppercase text-xs text-slate-500">Contacts d'urgence</h6>
                    <ul class="mx-3 flex flex-col pl-0 mb-0 rounded-lg">
                        {% if user.emergencyContacts is empty %}
                            <li class="relative flex items-center px-0 py-2 bg-white border-0 rounded-t-lg text-inherit">
                                <div class="w-full mx-2 p-1 text-center justify-center bg-slate-100 bg-opacity-40 border rounded border-dashed border-slate-300 hover:border-solid">
                                    <span onclick="openEmergencyContactModal()" class="text-xs font-semibold leading-tight text-slate-500 cursor-pointer hover:scale-102 hover:text-slate-900 hover:underline"><strong class="font-extrabold">+ </strong>Ajouter un contact</span>
                                </div>
                            </li>
                        {% else %}
                            {% for contact in user.emergencyContacts %}
                                <li class="relative flex items-center px-0 py-2 bg-white border-0 rounded-t-lg text-inherit">
                                    <div class="flex flex-col items-start justify-center">
                                        <h6 class="mb-0 leading-normal text-sm">{{ contact.name }}</h6>
                                        <p class="mb-0 leading-tight text-xs">{{ contact.phone }}</p>
                                    </div>
                                    <a onclick="editEmergencyContact({{ contact.id }}, '{{ contact.name|e('js') }}', '{{ contact.phone|e('js') }}')"
                                       class="inline-block pl-0 pr-4 mb-0 ml-auto font-bold text-center align-middle transition-all bg-transparent border-0 rounded-lg shadow-none cursor-pointer leading-pro text-xs ease-soft-in text-slate-400 hover:text-slate-700 hover:underline"
                                       href="javascript:;">Modifier</a>
                                    <div class="h-4 mx-1 bg-slate-300 w-px"></div>
                                    <a onclick="deleteEmergencyContact({{ contact.id }})"
                                       class="inline-block pl-4 mb-0 ml-0 font-bold text-center align-middle transition-all bg-transparent border-0 shadow-none cursor-pointer leading-pro text-xs ease-soft-in text-slate-400 hover:text-red-600 hover:underline"
                                       href="javascript:;">Supprimer</a>
                                </li>
                            {% endfor %}
                            <li class="relative flex items-center px-0 py-2 bg-white border-0 rounded-t-lg text-inherit">
                                <div class="w-full mx-2 p-1 text-center justify-center bg-slate-100 bg-opacity-40 border rounded border-dashed border-slate-300 hover:border-solid">
