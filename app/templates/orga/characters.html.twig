{% extends 'base.html.twig' %}

{% block title %}Gestion des personnages{% endblock %}

{% block body %}
<div class="w-full px-6 py-6 mx-auto">
    <div class="flex flex-wrap -mx-3">
        <div class="flex-none w-full max-w-full px-3">
            <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-6 pb-0 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                    <div class="flex flex-wrap -mx-3">
                        <div class="flex-none w-full max-w-full px-3 grid grid-cols-2 gap-4 mb-6">
                            <div class="flex items-center justify-self-start ">
                                <h6>{{ title }}</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex-auto px-6 pb-2 border-t pt-6">
                    <div class="p-0 overflow-x-auto">
                        <table id="charactersTable" class="display">
                            <thead>
                                <tr>
                                    <th class="">Joueur</th>
                                    <th class="">Personnage</th>
                                    <th class="">Faction</th>
                                    <th class="">Classe</th>
                                    <th class="">Statut</th>
                                    <th class=""></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for character in characters %}
                                <tr>
                                    <td>
                                        <div class="d-flex px-2 py-1">
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-sm">{{ character.user.getFullName() }}</h6>
                                                <p class="text-xs text-secondary mb-0">{{ character.user.email }}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <p class="text-sm font-weight-bold mb-0">{{ character.name|raw }}</p>
                                    </td>
                                    <td class="align-middle text-center text-sm">
                                        <span class="badge badge-sm bg-gradient-info">{{ character.faction }}</span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <span class="text-secondary text-sm font-weight-bold">{{ character.getClassLabel() }}</span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <span class="badge badge-sm bg-gradient-warning">{{ character.getValidationType().getLabel() }}</span>
                                    </td>
                                    <td class="align-middle">
                                        <a href="{{ path('app_orga_character_edit', {'id': character.id}) }}" class="inline-block px-2 py-1 font-bold text-center text-white uppercase align-middle transition-all rounded-lg cursor-pointer bg-gradient-to-tl from-cyan-300 to-cyan-600 leading-pro text-xs ease-soft-in tracking-tight-soft shadow-soft-md bg-150 bg-x-25 hover:scale-102 active:opacity-85 hover:shadow-soft-xs hover:text-cyan-100">
                                            <i class="ni ni-settings text-sm"></i>
                                        </a>
                                        {% if character.isInValidation() %}
                                        <button type="button" class="inline-block px-2 py-1 font-bold text-center text-white uppercase align-middle transition-all rounded-lg cursor-pointer bg-gradient-to-tl from-green-300 to-green-600 leading-pro text-xs ease-soft-in tracking-tight-soft shadow-soft-md bg-150 bg-x-25 hover:scale-102 active:opacity-85 hover:shadow-soft-xs hover:text-green-100" onclick="confirmValidateCharacter({{ character.id }})">
                                            <i class="ni ni-check-bold text-sm"></i>
                                        </button>
                                        {% endif %}
                                        {% if character.isInValidation() %}
                                        <button type="button" class="inline-block px-2 py-1 font-bold text-center text-white uppercase align-middle transition-all rounded-lg cursor-pointer bg-gradient-to-tl from-red-300 to-red-600 leading-pro text-xs ease-soft-in tracking-tight-soft shadow-soft-md bg-150 bg-x-25 hover:scale-102 active:opacity-85 hover:shadow-soft-xs hover:text-red-100" onclick="confirmRejectCharacter({{ character.id }})">
                                            <i class="ni ni-fat-remove text-sm"></i>
                                        </button>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
$(document).ready(function() {
    $('#charactersTable').DataTable({
        responsive: true,
        searching: true,
        ordering: true,
        paging: true,
        info: true,
        lengthChange: true,
        lengthMenu: [10, 25, 50, 100],
        language: {
            url: "{{ asset('build/plugins/fr-FR.json') }}"
        }
    });
});

function showCharacterDetails(id, name, userName, userEmail, faction, characterClass, description, background) {
    createModal({
        title: `Détails du personnage : ${name}`,
        html: `
            <div class="row">
                <div class="col-md-6">
                    <h6>Informations générales</h6>
                    <p><strong>Joueur :</strong> ${userName}</p>
                    <p><strong>Email :</strong> ${userEmail}</p>
                    <p><strong>Faction :</strong> ${faction}</p>
                    <p><strong>Classe :</strong> ${characterClass}</p>
                </div>
                <div class="col-md-6">
                    <h6>Description</h6>
                    <p>${description}</p>
                    <h6>Background</h6>
                    <p>${background}</p>
                </div>
            </div>
        `,
        confirmButtonText: "Fermer",
        showCancelButton: false,
        customClass: {
            confirmButton: window.BUTTON_CLASSES.secondary
        }
    });
}

function confirmValidateCharacter(characterId) {
    createModal({
        title: "Confirmation de validation",
        html: `Êtes-vous sûr de vouloir valider ce personnage ?<br/><br/><span class="text-green-700">Cette action permettra à lae joueureuse d'imprimer sa fiche.</span>`,
        confirmButtonText: "Valider",
        getData: () => ({}),
        validate: () => true,
        url: `/api/character/${characterId}/validate`,
        successTitle: "Personnage validé !",
        successMessage: "Le personnage a été validé avec succès.",
        onSuccess: () => {
            // Recharger la page après la validation
            window.location.reload();
        }
    });
}

function confirmRejectCharacter(characterId) {
    createModal({
        title: "Confirmation de rejet",
        html: `Êtes-vous sûr de vouloir rejeter ce personnage ?<br/><br/><span class="text-red-700">Cette action permettra à lae joueureuse de modifier à nouveau son personnage.</span>`,
        confirmButtonText: "Rejeter",
        getData: () => ({}),
        validate: () => true,
        url: `/api/character/${characterId}/reject`,
        successTitle: "Personnage rejeté !",
        successMessage: "Le personnage a été rejeté avec succès.",
        onSuccess: () => {
            // Recharger la page après le rejet
            window.location.reload();
        }
    });
}
</script>
{% endblock %} 