{% extends 'base.html.twig' %}

{% block title %}Organisation{% endblock %}

{% block body %}
<div class="w-full px-6 py-6 mx-auto">
    <div class="flex flex-wrap -mx-3">
        <div class="flex-none w-full max-w-full px-3">
            <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-6 pb-4 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h6 class="mb-1">Tableau de bord organisateur</h6>
                            <p class="text-sm text-slate-500">Indicateurs pour l’opus en cours et accès rapides.</p>
                        </div>
                    </div>
                </div>

                <div class="flex-auto px-6 pb-6 border-t pt-6">
                    {% if orga_no_open_event %}
                        <div class="rounded-2xl border border-amber-200 bg-amber-50/80 px-4 py-3 text-sm text-amber-900 mb-8">
                            Aucun opus ouvert en configuration — les indicateurs ci-dessous ne s’appliquent pas.
                        </div>
                    {% else %}
                        <p class="text-sm text-slate-700 mb-6">
                            <span class="font-semibold text-slate-800">Opus en cours :</span>
                            {{ orga_open_event_labels|join(', ') }}
                        </p>

                        <div class="flex flex-wrap -mx-3 mb-8">
                            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
                                <div class="h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="min-w-0">
                                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Inscriptions</p>
                                            <p class="mt-2 text-3xl font-bold text-slate-800 tabular-nums">{{ orga_registered_distinct }}</p>
                                            <p class="mt-2 text-sm text-slate-500">Comptes distincts (plusieurs billets = une personne)</p>
                                        </div>
                                        <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                                            <i class="ni ni-badge text-lg" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
                                <div class="h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="min-w-0">
                                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Validation</p>
                                            <p class="mt-2 text-3xl font-bold text-slate-800 tabular-nums">{{ orga_validated_main_count }}</p>
                                            <p class="mt-2 text-sm text-slate-500">Fiches Principal validées, joueur inscrit à l’opus</p>
                                        </div>
                                        <div class="shrink-0 rounded-xl bg-emerald-50 p-3 text-emerald-700">
                                            <i class="ni ni-check-bold text-lg" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-8">
                            <h6 class="mb-1 text-slate-800">Détail par faction</h6>
                            <p class="text-sm text-slate-500 mb-4">Inscrits selon la faction du <em>profil</em> si renseignée, sinon celle du <em>personnage principal</em> ; principaux validés selon la faction de la <em>fiche personnage</em>.</p>
                            <div class="overflow-x-auto rounded-2xl border border-slate-200">
                                <table class="w-full text-sm text-left text-slate-700">
                                    <thead class="text-xs font-semibold uppercase tracking-wide text-slate-500 bg-slate-50 border-b border-slate-200">
                                        <tr>
                                            <th scope="col" class="px-4 py-3">Faction</th>
                                            <th scope="col" class="px-4 py-3 text-end">Personnes inscrites</th>
                                            <th scope="col" class="px-4 py-3 text-end">Principaux validés</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        {% for row in orga_faction_rows %}
                                            <tr class="bg-white hover:bg-slate-50/80">
                                                <td class="px-4 py-3 align-top">
                                                    <span class="font-medium text-slate-800">{{ row.label }}</span>
                                                    {% if row.hint is defined %}
                                                        <p class="mt-1 text-xs text-slate-500 leading-snug">{{ row.hint }}</p>
                                                    {% endif %}
                                                </td>
                                                <td class="px-4 py-3 text-end tabular-nums">{{ row.registered }}</td>
                                                <td class="px-4 py-3 text-end tabular-nums">{{ row.validated_mains }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                    <tfoot class="bg-slate-50 border-t border-slate-200 text-slate-800 font-semibold">
                                        <tr>
                                            <th scope="row" class="px-4 py-3 text-left font-semibold">Total</th>
                                            <td class="px-4 py-3 text-end tabular-nums">{{ orga_registered_distinct }}</td>
                                            <td class="px-4 py-3 text-end tabular-nums">{{ orga_validated_main_count }}</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    {% endif %}

                    <h6 class="mb-4 text-slate-800">Accès rapides</h6>
                    <div class="flex flex-wrap -mx-3">
                        <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
                            <a href="{{ path('app_orga_characters') }}"
                               class="group block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm transition-all hover:-translate-y-0.5 hover:shadow-soft-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="min-w-0">
                                        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Personnages</p>
                                        <h6 class="mt-1 mb-2 text-slate-800 group-hover:text-slate-900">Gestion des personnages</h6>
                                        <p class="text-sm text-slate-500">Validez et gérez les personnages des joueurs.</p>
                                    </div>
                                    <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                                        <i class="ni ni-settings" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <div class="mt-4 flex items-center justify-between gap-3">
                                    <span class="text-sm font-semibold text-cyan-700">Accéder</span>
                                    <span class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
