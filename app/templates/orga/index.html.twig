{% extends 'base.html.twig' %}

{% block title %}Organisation{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0">
                    <h6>Tableau de bord organisateur</h6>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    <div class="p-4">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Gestion des personnages</h5>
                                        <p class="card-text">Validez et gérez les personnages des joueurs.</p>
                                        <a href="{{ path('app_orga_characters') }}" class="btn btn-primary">Accéder</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
