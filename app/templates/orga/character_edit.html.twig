                const gearCost = $this.parents('tr').find('[data-gear-cost]').text();
                const gearBaseCost = $this.parents('tr').find('[data-gear-base-cost]').data('gear-base-cost');
                const gearNote = $this.parents('tr').find('[data-gear-note]').text();
                const gearNoteOrga = $this.parents('tr').find('[data-gear-note-orga]').text();
                $('#gearName').text(gearName);
                $('#gearDescription').text(gearDescription);
                $('#gearCost').val(gearCost);
                $('#gearBaseCost').text(gearBaseCost);
                $('#gearNote').val(gearNote);
                $('#gearNoteOrga').val(gearNoteOrga);
                console.log($this.parents('tr'), gearName, gearDescription, gearCost, gearNote, gearNoteOrga);
            },
            getData: () => ({
                possessionId: possessionId,
                cost: $('#gearCost').val(),
                note: $('#gearNote').val(),
                noteOrga: $('#gearNoteOrga').val(),

            }),
            validate: () => true,
            url: "{{ path('api_character_gear_edit', {'id': character.id}) }}",
            successTitle: "Équipement modifié !",
            successMessage: "L'équipement a été modifié avec succès."
        });
    }

    function editAssetModal(event, characterAssetId, assetType, isCatalog = false) {
        $this = $(event.target);
        createModal({
            title: assetsModal[assetType].editTitle,
            html: `
                <form id="editAssetForm" class="text-left">
                  ${isCatalog ? `
                    <div class="mb-6 text-left">
                      <label class="block text-sm font-extrabold text-slate-700">Nom de la ${assetsModal[assetType].label}</label>
                      <input type="text" id="assetName" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow">
                      <p class="text-sm leading-normal">
                        <strong class="font-extrabold text-slate-700"> <span>Description</span> :</strong> <textarea id="assetDescription" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow"></textarea>
                      </p>
                      <p class="text-sm leading-normal">
                        <strong class="font-extrabold text-slate-700"> <span>Déscription courte</span> :</strong> <input type="text" id="assetShort" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow">
                      </p>
                    </div>
                  ` : `
                    <div class="mb-6 text-left">
                      <p class="text-sm leading-normal">              
                        <strong class="font-extrabold text-slate-700"> <span id="assetName">Nom de l'équipement</span> :</strong> <span id="assetDescription">Description de l'équipement</span><br/> 
                      </p>
                    </div>
                    `}
                    ${assetType == 'Object' ? `
                    <div class="mb-6 text-left">
                      <p class="text-sm leading-normal">              
                        <strong class="font-extrabold text-slate-700"> <span>Quantité :</strong> <input type="number" id="assetQuantity" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow">
                      </p>
                    </div>
                    ` : ``}
                    <div class="mb-6">
                      <textarea id="assetNote" rows="3" cols="20" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Commentaire visible par lae joueureuse" required></textarea>
                    </div>
                    <div class="mb-6">
                      <textarea id="assetNoteOrga" rows="3" cols="20" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" placeholder="Commentaire seulement visible par les orgas" required></textarea>
                    </div>
                </form>
            `,
            getData: () => ({
                characterAssetId: characterAssetId,
                note: $('#assetNote').val(),
                noteOrga: $('#assetNoteOrga').val(),
                assetQuantity: $('#assetQuantity') ? $('#assetQuantity').val() : 1,
                assetName: $('#assetName').is('input') ? $('#assetName').val() : $('#assetName').text(),
                assetDescription: $('#assetDescription').is('textarea') ? $('#assetDescription').val() : $('#assetDescription').text(),
                assetShort: $('#assetShort').is('input') ? $('#assetShort').val() : $('#assetShort').text(),
            }),
            didOpen: () => {
                const assetName = $this.parents('tr').find('[data-asset-name]').data('asset-name');
                const assetDescription = $this.parents('tr').find('[data-asset-description]').text();
                const assetShort = $this.parents('tr').find('[data-asset-short]').data('asset-short');
                const assetQuantity = $this.parents('tr').find('[data-asset-quantity]').text();
                const assetNote = $this.parents('tr').find('[data-asset-note]').text();
                const assetNoteOrga = $this.parents('tr').find('[data-asset-note-orga]').text();
                if($('#assetName').is('input')) {
                    $('#assetName').val(assetName);
                } else {
                    $('#assetName').text(assetName);
                }
                $('#assetDescription').text(assetDescription);
                $('#assetShort').val(assetShort);
                if (assetQuantity) {
                    $('#assetQuantity').val(assetQuantity);
                }
                $('#assetNote').val(assetNote);
                $('#assetNoteOrga').val(assetNoteOrga);
            },
            validate: () => true,
            url: "{{ path('api_character_asset_edit', {'id': character.id}) }}",
            successTitle: assetsModal[assetType].editSuccessTitle,
            successMessage: assetsModal[assetType].editSuccessMessage
        });
    }
    
    
  </script>

{% endblock %}