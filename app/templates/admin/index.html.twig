{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
<div class="w-full px-6 py-6 mx-auto">
  <div class="flex flex-wrap -mx-3"> 
    <div class="flex-none w-full max-w-full px-3">
      <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
        <div class="p-6 pb-4 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h6 class="mb-1">Tableau de bord administrateur</h6>
              <p class="text-sm text-slate-500">Accédez rapidement aux actions de gestion les plus courantes.</p>
            </div>
            <a href="{{ path('app_home') }}" class="text-sm text-slate-600 hover:text-slate-800 whitespace-nowrap">Retour au site</a>
          </div>
        </div>

        <div class="flex-auto px-6 pb-6 border-t pt-6">
          <div class="flex flex-wrap -mx-3">
            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
              <a href="{{ path('app_admin_users') }}"
                 class="group block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm transition-all hover:-translate-y-0.5 hover:shadow-soft-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Utilisateurs</p>
                  <h6 class="mt-1 mb-2 text-slate-800 group-hover:text-slate-900">Gestion des utilisateurs</h6>
                  <p class="text-sm text-slate-500">Gérez les utilisateurs et leurs rôles.</p>
                </div>
                <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                  <i class="ni ni-circle-08" aria-hidden="true"></i>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-cyan-700">Accéder</span>
                <span class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </div>
              </a>
            </div>

            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
              <a href="{{ path('app_admin_add_participation') }}"
                 class="group block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm transition-all hover:-translate-y-0.5 hover:shadow-soft-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Participations</p>
                  <h6 class="mt-1 mb-2 text-slate-800 group-hover:text-slate-900">Ajouter des participations</h6>
                  <p class="text-sm text-slate-500">Ajoutez des inscriptions manuelles à un joueur.</p>
                </div>
                <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                  <i class="ni ni-fat-add" aria-hidden="true"></i>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-cyan-700">Accéder</span>
                <span class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </div>
              </a>
            </div>

            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
              <a href="{{ path('admin_send_invite') }}"
                 class="group block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm transition-all hover:-translate-y-0.5 hover:shadow-soft-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Communication</p>
                  <h6 class="mt-1 mb-2 text-slate-800 group-hover:text-slate-900">Envoyer un mail d'invitation</h6>
                  <p class="text-sm text-slate-500">Envoyez un mail d'invitation à tous les utilisateurs.</p>
                </div>
                <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                  <i class="ni ni-email-83" aria-hidden="true"></i>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-cyan-700">Accéder</span>
                <span class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </div>
              </a>
            </div>

            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
              <a href="{{ path('app_admin_import_tickets') }}"
                 class="group block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm transition-all hover:-translate-y-0.5 hover:shadow-soft-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Billetterie</p>
                  <h6 class="mt-1 mb-2 text-slate-800 group-hover:text-slate-900">Importer des billets (CSV)</h6>
                  <p class="text-sm text-slate-500">Importez des billets depuis un export CSV HelloAsso.</p>
                </div>
                <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                  <i class="ni ni-cloud-upload-96" aria-hidden="true"></i>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-cyan-700">Accéder</span>
                <span class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </div>
              </a>
            </div>

            <div class="flex-none w-full max-w-full px-3 mb-4 md:w-6/12 xl:w-4/12">
              <a href="{{ path('app_admin_place_pj_faction_sync') }}"
                 class="group block h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-soft-sm transition-all hover:-translate-y-0.5 hover:shadow-soft-xl focus:outline-none focus:ring-2 focus:ring-cyan-500">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Profils</p>
                  <h6 class="mt-1 mb-2 text-slate-800 group-hover:text-slate-900">Faction depuis billet Place PJ</h6>
                  <p class="text-sm text-slate-500">Renseignez la faction profil à partir du tarif d’inscription (opus ouvert).</p>
                </div>
                <div class="shrink-0 rounded-xl bg-cyan-50 p-3 text-cyan-700">
                  <i class="ni ni-badge" aria-hidden="true"></i>
                </div>
              </div>
              <div class="mt-4 flex items-center justify-between gap-3">
                <span class="text-sm font-semibold text-cyan-700">Accéder</span>
                <span class="text-slate-400 transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %} 