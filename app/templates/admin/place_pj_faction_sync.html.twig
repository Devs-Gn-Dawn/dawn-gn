{% extends 'base.html.twig' %}

{% block title %}Faction depuis billet Place PJ{% endblock %}

{% block body %}
<div class="w-full px-6 py-6 mx-auto">
    <div class="flex flex-wrap -mx-3">
        <div class="flex-none w-full max-w-full px-3">
            <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-6 pb-0 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h6 class="mb-1">Faction depuis inscription « Place PJ »</h6>
                            <p class="text-sm text-slate-500 mt-1">
                                Utilisateurs inscrits à l’opus ouvert, sans faction résolue (profil ni personnage principal),
                                avec un tarif commençant par « Place PJ ». La faction proposée est déduite du libellé billet.
                            </p>
                        </div>
                        <a href="{{ path('app_admin') }}" class="text-sm text-slate-600 hover:text-slate-800 whitespace-nowrap">Retour à l’administration</a>
                    </div>
                </div>
                <div class="flex-auto px-6 pb-6 border-t pt-6">
                    {% for message in app.flashes('success') %}
                        <div class="p-3 mb-4 rounded-lg bg-green-50 text-green-800">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('warning') %}
                        <div class="p-3 mb-4 rounded-lg bg-amber-50 text-amber-900">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="p-3 mb-4 rounded-lg bg-red-50 text-red-800">{{ message }}</div>
                    {% endfor %}

                    {% if place_pj_open_slugs is empty %}
                        <div class="rounded-2xl border border-amber-200 bg-amber-50/80 px-4 py-3 text-sm text-amber-900">
                            Aucun opus ouvert en configuration — il n’y a pas d’inscriptions « en cours » pour cet outil.
                        </div>
                    {% else %}
                        <p class="text-sm text-slate-700 mb-4">
                            <span class="font-semibold text-slate-800">Opus pris en compte :</span>
                            {{ place_pj_open_labels|join(', ') }}
                        </p>

                        {% if place_pj_preview_rows is empty %}
                            <p class="text-sm text-slate-600">Aucun joueur à traiter pour ces critères.</p>
                        {% else %}
                            <form action="{{ path('app_admin_place_pj_faction_sync') }}" method="post" class="space-y-4">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_place_pj_faction_sync') }}">
                                <div class="flex flex-wrap items-center gap-3">
                                    <button type="submit" class="inline-block px-4 py-2 font-bold text-white uppercase align-middle transition-all rounded-lg cursor-pointer bg-gradient-to-tl from-cyan-300 to-cyan-600 leading-pro text-xs ease-soft-in tracking-tight-soft shadow-soft-md bg-150 bg-x-25 hover:scale-102 active:opacity-85 hover:shadow-soft-xs hover:text-cyan-100">
                                        Appliquer la sélection
                                    </button>
                                    <button type="button" id="place-pj-select-deductible" class="inline-block px-4 py-2 text-sm font-semibold text-cyan-700 border border-cyan-200 rounded-lg hover:bg-cyan-50">
                                        Tout sélectionner (déductibles)
                                    </button>
                                </div>
                                <div class="overflow-x-auto rounded-2xl border border-slate-200">
                                    <table class="w-full text-sm text-left text-slate-700">
                                        <thead class="text-xs font-semibold uppercase tracking-wide text-slate-500 bg-slate-50 border-b border-slate-200">
                                            <tr>
                                                <th scope="col" class="px-4 py-3 w-12"></th>
                                                <th scope="col" class="px-4 py-3">Joueur</th>
                                                <th scope="col" class="px-4 py-3">Email</th>
                                                <th scope="col" class="px-4 py-3">Tarif (item)</th>
                                                <th scope="col" class="px-4 py-3">Faction proposée</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            {% for row in place_pj_preview_rows %}
                                                {% set can_apply = row.inferred is not null %}
                                                <tr class="bg-white hover:bg-slate-50/80">
                                                    <td class="px-4 py-3 align-top">
                                                        <input type="checkbox"
                                                               name="registration_ids[]"
                                                               value="{{ row.registration.id }}"
                                                               class="rounded border-slate-300 text-cyan-600 focus:ring-cyan-500 place-pj-row-checkbox"
                                                               {{ can_apply ? '' : 'disabled' }}>
                                                    </td>
                                                    <td class="px-4 py-3 align-top font-medium text-slate-800">
                                                        {{ row.user.firstname }} {{ row.user.name }}
                                                    </td>
                                                    <td class="px-4 py-3 align-top">{{ row.user.email }}</td>
                                                    <td class="px-4 py-3 align-top text-slate-600">{{ row.registration.itemName }}</td>
                                                    <td class="px-4 py-3 align-top">
                                                        {% if can_apply %}
                                                            <span class="font-medium text-emerald-800">{{ row.inferredLabel }}</span>
                                                        {% else %}
                                                            <span class="text-slate-500">Non déductible</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% if place_pj_open_slugs is not empty and place_pj_preview_rows is not empty %}
<script>
  (function () {
    const btn = document.getElementById('place-pj-select-deductible');
    if (!btn) return;
    btn.addEventListener('click', function () {
      document.querySelectorAll('input.place-pj-row-checkbox:not(:disabled)').forEach(function (cb) {
        cb.checked = true;
      });
    });
  })();
</script>
{% endif %}
{% endblock %}
