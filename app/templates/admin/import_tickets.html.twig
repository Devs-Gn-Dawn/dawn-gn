{% extends 'base.html.twig' %}

{% block title %}Importer des billets (CSV){% endblock %}

{% block body %}
<div class="w-full px-6 py-6 mx-auto">
    <div class="flex flex-wrap -mx-3">
        <div class="flex-none w-full max-w-full px-3">
            <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-6 pb-0 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                    <div class="flex flex-wrap -mx-3">
                        <div class="flex-none w-full max-w-full px-3 mb-6">
                            <h6>Importer des billets depuis un export CSV HelloAsso</h6>
                            <p class="text-sm text-slate-500 mt-1">Seules les lignes avec le statut « Validé » sont traitées. Les billets déjà présents en base sont ignorés.</p>
                        </div>
                    </div>
                </div>
                <div class="flex-auto px-6 pb-2 border-t pt-6">
                    {% for message in app.flashes('success') %}
                        <div class="p-3 mb-4 rounded-lg bg-green-50 text-green-800">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="p-3 mb-4 rounded-lg bg-red-50 text-red-800">{{ message }}</div>
                    {% endfor %}
                    <form action="{{ path('app_admin_import_tickets') }}" method="post" enctype="multipart/form-data" class="space-y-4">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('import_tickets') }}">
                        <div class="form-group">
                            <label for="csv" class="block text-sm font-medium text-slate-700 mb-1">Fichier CSV</label>
                            <input type="file" id="csv" name="csv" accept=".csv" required class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:font-medium file:bg-cyan-50 file:text-cyan-700 hover:file:bg-cyan-100">
                        </div>
                        <div class="form-group">
                            <label for="event" class="block text-sm font-medium text-slate-700 mb-1">Événement</label>
                            <select id="event" name="event" required class="block w-full rounded-lg border border-slate-300 py-2 px-3 text-slate-700 focus:border-cyan-500 focus:ring-cyan-500">
                                <option value="">-- Choisir un événement --</option>
                                {% for label, value in eventChoices %}
                                    <option value="{{ value }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="inline-block px-4 py-2 font-bold text-white uppercase align-middle transition-all rounded-lg cursor-pointer bg-gradient-to-tl from-cyan-300 to-cyan-600 leading-pro text-xs ease-soft-in tracking-tight-soft shadow-soft-md bg-150 bg-x-25 hover:scale-102 active:opacity-85 hover:shadow-soft-xs hover:text-cyan-100">Importer</button>
                        <a href="{{ path('app_admin') }}" class="inline-block px-4 py-2 ml-2 text-slate-600 hover:text-slate-800">Retour à l'administration</a>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {% if importResult is not null %}
    <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border mt-6">
        <div class="p-6">
            <h6 class="mb-4">Résultat de l'import</h6>
            <dl class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <div><dt class="text-sm text-slate-500">Lignes lues</dt><dd class="font-medium">{{ importResult.linesRead }}</dd></div>
                <div><dt class="text-sm text-slate-500">Lignes traitées (statut Validé)</dt><dd class="font-medium">{{ importResult.processed }}</dd></div>
                <div><dt class="text-sm text-slate-500">Inscriptions créées</dt><dd class="font-medium text-green-600">{{ importResult.created }}</dd></div>
                <div><dt class="text-sm text-slate-500">Ignorées (billet déjà en base)</dt><dd class="font-medium">{{ importResult.ignored }}</dd></div>
                <div><dt class="text-sm text-slate-500">Doublons (alerte admin envoyée)</dt><dd class="font-medium">{{ importResult.duplicates }}</dd></div>
            </dl>
            {% if importResult.errors|length > 0 %}
            <div class="mt-4">
                <h6 class="text-sm font-medium text-slate-700 mb-2">Erreurs</h6>
                <ul class="text-sm text-red-600 list-disc list-inside space-y-1">
                    {% for err in importResult.errors %}
                        <li>Ligne {{ err.line }} : {{ err.message }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
