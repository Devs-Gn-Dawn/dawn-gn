{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="w-full px-6 py-6 mx-auto">
    <div class="flex flex-wrap -mx-3">
        <div class="flex-none w-full max-w-full px-3">
            <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
                <div class="p-6 pb-0 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                    <div class="flex flex-wrap -mx-3">
                        <div class="flex-none w-full max-w-full px-3">
                            <div class="flex items-center justify-between">
                                <h6>Liste des utilisateurs</h6>
                            </div>
                        </div>
                        <div class="flex-none w-full max-w-full px-3 mt-4">
                            <div class="flex justify-end">
                                <div class="btn-group" role="group">
                                    <button type="button" class="btn btn-outline-primary btn-sm mb-0 ms-2" onclick="showAddUserModal()">
                                        <i class="ni ni-fat-add"></i> Nouvel utilisateur
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="flex-auto px-0 pt-0 pb-2">
                    <div class="p-0 overflow-x-auto">
                        <table id="usersTable" class="display">
                            <thead class="">
                                <tr>
                                    <th class="">Utilisateur</th>
                                    <th class="">Email</th>
                                    <th class="">Rôles</th>
                                    <th class="">Personnages</th>
                                    <th class="">Inscriptions</th>
                                    <th class=""></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in users %}
                                <tr>
                                    <td class="">
                                        <div class="flex px-2 py-1">
                                            <div class="flex flex-col justify-center">
                                                <h6 class="mb-0 text-sm leading-normal">{{ user.firstname }} {{ user.name }}</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="">
                                        <p class="mb-0 text-xs font-semibold leading-tight">{{ user.email }}</p>
                                    </td>
                                    <td class="">
                                        {% for role in user.roles %}
                                            {% if role == 'ROLE_ADMIN' %}
                                                <span class="badge badge-sm bg-gradient-danger">Admin</span>
                                            {% elseif role == 'ROLE_ORGA' %}
                                                <span class="badge badge-sm bg-gradient-warning">Orga</span>
                                            {% else %}
                                                <span class="badge badge-sm bg-gradient-info">User</span>
                                            {% endif %}
                                        {% endfor %}
                                    </td>
                                    <td class="">
                                        <span class="text-xs font-semibold leading-tight">{{ user.characters|length }}</span>
                                    </td>
                                    <td class="">
                                        <span class="text-xs font-semibold leading-tight">{{ user.registrations|length }}</span>
                                    </td>
                                    <td class="">
                                        <button type="button" class="text-xs font-semibold leading-tight text-slate-400 hover:text-slate-700 hover:underline hover:scale-102" onclick="showEditUserModal({{ user.id }}, '{{ user.name }}', '{{ user.firstname }}', '{{ user.email }}', '{{ user.phone }}', {{ user.roles|json_encode }})">
                                            <i class="ni ni-settings text-sm"></i>
                                        </button>
                                        <button type="button" class="text-xs font-semibold leading-tight text-slate-400 hover:text-slate-700 hover:underline hover:scale-102 ms-2" onclick="deleteUser({{ user.id }})">
                                            <i class="ni ni-fat-remove text-sm"></i>
                                        </button>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
$(document).ready(function() {
    $('#usersTable').DataTable({
        responsive: true,
        searching: true,
        ordering: true,
        paging: true,
        info: true,
        lengthChange: true,
        lengthMenu: [10, 25, 50, 100],
        
    });
});

function showEditUserModal(userId, name, firstname, email, phone, roles) {
    createModal({
        title: `Modifier l'utilisateur : ${firstname} ${name}`,
        html: `
            <form id="editUserForm" class="text-left">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Nom</label>
                    <input type="text" id="name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" value="${name}">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Prénom</label>
                    <input type="text" id="firstname" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" value="${firstname}">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="email" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" value="${email}">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Téléphone</label>
                    <input type="text" id="phone" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" value="${phone}">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Rôles</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="roleAdmin" ${roles.includes('ROLE_ADMIN') ? 'checked' : ''}>
                        <label class="form-check-label" for="roleAdmin">Administrateur</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="roleOrga" ${roles.includes('ROLE_ORGA') ? 'checked' : ''}>
                        <label class="form-check-label" for="roleOrga">Organisateur</label>
                    </div>
                </div>
            </form>
        `,
        getData: () => {
            const roles = ['ROLE_USER'];
            if (document.getElementById('roleAdmin').checked) roles.push('ROLE_ADMIN');
            if (document.getElementById('roleOrga').checked) roles.push('ROLE_ORGA');
            
            return {
                name: document.getElementById('name').value,
                firstname: document.getElementById('firstname').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                roles: roles
            };
        },
        validate: (data) => data.name && data.firstname && data.email,
        url: "{{ path('api_user_update', {'id': 'USER_ID'}) }}".replace('USER_ID', userId),
        confirmButtonText: "Enregistrer",
        successTitle: "Utilisateur modifié !",
        successMessage: "Les modifications ont été enregistrées avec succès."
    });
}

function showAddUserModal() {
    createModal({
        title: "Nouvel utilisateur",
        html: `
            <form id="addUserForm" class="text-left">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Nom</label>
                    <input type="text" id="name" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Prénom</label>
                    <input type="text" id="firstname" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" id="email" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Téléphone</label>
                    <input type="text" id="phone" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Mot de passe</label>
                    <input type="password" id="password" class="text-sm focus:shadow-soft-primary-outline leading-5.6 ease-soft block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding py-2 px-3 mt-1 font-normal text-gray-800 transition-all focus:border-fuchsia-300 focus:bg-white focus:text-gray-800 focus:outline-none focus:transition-shadow" required>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700">Rôles</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="roleAdmin">
                        <label class="form-check-label" for="roleAdmin">Administrateur</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="roleOrga">
                        <label class="form-check-label" for="roleOrga">Organisateur</label>
                    </div>
                </div>
            </form>
        `,
        getData: () => {
            const roles = ['ROLE_USER'];
            if (document.getElementById('roleAdmin').checked) roles.push('ROLE_ADMIN');
            if (document.getElementById('roleOrga').checked) roles.push('ROLE_ORGA');
            
            return {
                name: document.getElementById('name').value,
                firstname: document.getElementById('firstname').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                password: document.getElementById('password').value,
                roles: roles
            };
        },
        validate: (data) => data.name && data.firstname && data.email && data.phone && data.password,
        url: "{{ path('api_user_create') }}",
        confirmButtonText: "Créer",
        successTitle: "Utilisateur créé !",
        successMessage: "L'utilisateur a été créé avec succès."
    });
}

function deleteUser(userId) {
    confirmDelete("{{ path('api_user_delete', {'id': 'USER_ID'}) }}".replace('USER_ID', userId), {
        successTitle: "Utilisateur supprimé !",
        successMessage: "L'utilisateur a été supprimé avec succès."
    });
}
</script>
{% endblock %}