{% extends 'base.html.twig' %}

{% block title %}Ajouter une compétence{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-6">
            <h1 class="text-2xl font-bold mb-6">Ajouter une compétence à {{ character.name }}</h1>

            <div class="grid grid-cols-1 gap-6">
                {% for skill in skills %}
                <div class="border rounded-lg p-4 hover:bg-gray-50">
                    <div class="flex justify-between items-start">
                        <div>
                            <h2 class="text-xl font-semibold text-gray-800">{{ skill.label }}</h2>
                            <p class="text-gray-600 mt-1">{{ skill.short }}</p>
                            <p class="text-gray-700 mt-2">{{ skill.description }}</p>
                            <div class="mt-2">
                                <span class="inline-block bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">
                                    Coût : {{ skill.baseCost }} PA
                                </span>
                            </div>
                        </div>
                        <form action="{{ path('character_skill_add', {'id': character.id}) }}" method="POST" class="ml-4">
                            <input type="hidden" name="skill_id" value="{{ skill.id }}">
                            <button type="submit" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">
                                Ajouter
                            </button>
                        </form>
                    </div>
                </div>
                {% else %}
                <div class="text-center text-gray-500 py-8">
                    Aucune compétence disponible pour votre personnage.
                </div>
                {% endfor %}
            </div>

            <div class="mt-6">
                <a href="{{ path('app_character_edit', {'id': character.id}) }}" class="text-blue-500 hover:text-blue-700">
                    <i class="fas fa-arrow-left mr-2"></i>Retour à la fiche du personnage
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %} 