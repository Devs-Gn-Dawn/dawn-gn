{% extends 'base.html.twig' %}

{% block title %}Mes Personnages{% endblock %}

{% block body %}
    <div class="w-full px-6 py-6 mx-auto">
        <div class="flex flex-wrap -mx-3">
            <div class="flex-none w-full max-w-full px-3">
                <div class="relative flex flex-col min-w-0 mb-6 break-words bg-white border-0 border-transparent border-solid shadow-soft-xl rounded-2xl bg-clip-border">
                    <div class="p-6 pb-0 mb-0 bg-white border-b-0 border-b-solid rounded-t-2xl border-b-transparent">
                        <h6>Liste des personnages</h6>
                    </div>

                    <div class="flex-auto px-0 pt-0 pb-2">
                        <div class="p-0 overflow-x-auto">
                            <table class="items-center w-full mb-0 align-top border-gray-200 text-slate-500">
                                <thead class="align-bottom">
                                    <tr>
                                        <th class="px-6 py-3 font-bold text-left uppercase align-middle bg-transparent border-b border-gray-200 shadow-none text-xxs border-b-solid tracking-none whitespace-nowrap text-slate-400 opacity-70">Nom</th>
                                        <th class="px-6 py-3 pl-2 font-bold text-left uppercase align-middle bg-transparent border-b border-gray-200 shadow-none text-xxs border-b-solid tracking-none whitespace-nowrap text-slate-400 opacity-70">Faction</th>
                                        <th class="px-6 py-3 font-bold text-center uppercase align-middle bg-transparent border-b border-gray-200 shadow-none text-xxs border-b-solid tracking-none whitespace-nowrap text-slate-400 opacity-70">Type</th>
                                        <th class="px-6 py-3 font-bold text-center uppercase align-middle bg-transparent border-b border-gray-200 shadow-none text-xxs border-b-solid tracking-none whitespace-nowrap text-slate-400 opacity-70">Statut</th>
                                        <th class="px-6 py-3 font-semibold capitalize align-middle bg-transparent border-b border-gray-200 border-solid shadow-none tracking-none whitespace-nowrap text-slate-400 opacity-70"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for character in characters %}
                                        <tr>
                                            <td class="p-2 align-middle bg-transparent border-b whitespace-nowrap shadow-transparent">
                                                <div class="flex px-2 py-1">
                                                    <div>
                                                        <img src="{{ asset('build/images/avatars/' ~ character.getAvatar() ~ '.jpg') }}" class="inline-flex items-center justify-center mr-4 text-sm text-white transition-all duration-200 ease-soft-in-out h-9 w-9 rounded-xl" alt="{{ character.name }}" />
                                                    </div>
                                                    <div class="flex flex-col justify-center">
                                                        <h6 class="mb-0 text-sm leading-normal">{{ character.name }}</h6>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="p-2 align-middle bg-transparent border-b whitespace-nowrap shadow-transparent">
                                                <p class="mb-0 text-xs font-semibold leading-tight">{{ character.faction }}</p>
                                                <p class="mb-0 text-xs leading-tight text-slate-400">{{ character.class }}</p>
                                            </td>
                                            <td class="p-2 text-sm leading-normal text-center align-middle bg-transparent border-b whitespace-nowrap shadow-transparent">
                                                {% if character.isMain %}
                                                    <span class="bg-gradient-to-tl from-green-600 to-lime-400 px-2.5 text-xs rounded-1.8 py-1.4 inline-block whitespace-nowrap text-center align-baseline font-bold uppercase leading-none text-white">Principal</span>
                                                {% endif %}
                                            </td>
                                            <td class="p-2 text-center align-middle bg-transparent border-b whitespace-nowrap shadow-transparent">
                                                <span class="text-xs font-semibold leading-tight text-slate-400">
                                                    {% if character.isValidated %}
                                                        Validé
                                                    {% else %}
                                                        Non validé
                                                    {% endif %}
                                                </span>
                                            </td>
                                            <td class="p-2 align-middle bg-transparent border-b whitespace-nowrap shadow-transparent">
                                                <a href="{{ path('app_character_edit', {'id': character.id}) }}" class="text-xs font-semibold leading-tight text-slate-400 cursor-pointer hover:text-slate-700 hover:underline">
                                                    Modifier
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="p-2 text-center">
                                                Vous n'avez pas encore de personnage.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            <div class="p-4">
                                <div onclick="showNewCharacterModal()" class="block w-full">
                                    <div class="flex mx-2 p-3 text-center justify-center bg-slate-100 bg-opacity-40 border rounded border-dashed border-slate-300 hover:bg-slate-200 transition-all duration-200 cursor-pointer">
                                        <span class="text-xs font-semibold leading-tight text-slate-500 hover:text-slate-700"><strong class="font-extrabold">+ </strong>Créer un nouveau personnage</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        window.factions = {{ factions|json_encode|raw }};
        
        window.showNewCharacterModal = function () {
            createModal({
                title: "Créer un nouveau personnage",
                html: `
                    <form id="newCharacterForm" class="text-left">
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700">Nom du personnage</label>
                            <input type="text" id="character_name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" required>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700">Faction</label>
                            <select id="faction-select" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" required>
                                <option value="">Choisir une faction</option>
                                ${Object.entries(window.factions).map(([label, value]) => 
                                    `<option value="${value}">${label}</option>`
                                ).join('')}
                            </select>
                        </div>
                        <div class="mb-4">
                            <label id="class-label" class="block text-sm font-medium text-gray-700">Classe</label>
                            <select id="class-select" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-slate-500 focus:ring-slate-500" required disabled>
                                <option value="">Choisir une classe</option>
                            </select>
                        </div>
                    </form>
                `,
                didOpen: () => {
                    const factionSelect = document.getElementById('faction-select');
                    const classSelect = document.getElementById('class-select');
                    const classLabel = document.getElementById('class-label');

                    factionSelect.addEventListener('change', async function() {
                        const selectedFaction = this.value;
                        classSelect.innerHTML = '<option value="">Choisir une classe</option>';
                        
                        if (!selectedFaction) {
                            classSelect.disabled = true;
                            classLabel.textContent = 'Classe (Sélectionnez d\'abord une faction)';
                            return;
                        }

                        try {
                            const response = await fetch(`/characters/api/classes/${selectedFaction}`);
                            const classes = await response.json();
                            
                            Object.entries(classes).forEach(([label, value]) => {
                                const option = document.createElement('option');
                                option.value = value;
                                option.textContent = label;
                                classSelect.appendChild(option);
                            });
                            
                            classSelect.disabled = false;
                            classLabel.textContent = 'Classe';
                        } catch (error) {
                            console.error('Erreur lors du chargement des classes:', error);
                            classSelect.disabled = true;
                            classLabel.textContent = 'Classe (Erreur de chargement)';
                        }
                    });
                    factionSelect.dispatchEvent(new Event('change'));
                },
                getData: () => ({
                    character_name: document.getElementById('character_name').value,
                    faction: document.getElementById('faction-select').value,
                    class: document.getElementById('class-select').value
                }),
                validate: (data) => data.character_name && data.faction && data.class,
                url: '/characters/new',
                confirmButtonText: 'Créer',
                successTitle: 'Personnage créé !',
                successMessage: 'Votre personnage a été créé avec succès.'
            });
        };
    </script>
{% endblock %} 