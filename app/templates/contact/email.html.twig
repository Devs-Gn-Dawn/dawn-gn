{% extends 'email/base.html.twig' %}

{% block title %}Nouveau message de contact{% endblock %}

{% block content %}
    <h2>Informations de l'expéditeur</h2>
    <p>
        <strong>Nom :</strong> {{ user.firstname ?? 'Non renseigné' }} {{ user.name ?? 'Non renseigné' }}<br>
        <strong>Email :</strong> {{ user.email ?? replyTo ?? 'Non renseigné' }}<br>
        <strong>Téléphone :</strong> {{ user.phone ?? 'Non renseigné' }}
    </p>

    <h2>Message</h2>
    <div style="white-space: pre-wrap;">{{ message }}</div>
{% endblock %} 