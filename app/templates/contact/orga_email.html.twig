{% extends 'email/base.html.twig' %}

{% block title %}Message des organisateurs{% endblock %}

{% block content %}
    <p>Bonjour,</p>

    <p>Vous avez reçu un message de la part des orgas :</p>

    <p style="background-color: #f8f9fa; padding: 20px; border-radius: 5px; margin: 20px 0;">
        <h3 style="margin-top: 0; margin-bottom: 10px; color: #1a202c;">{{ title }}</h3>
        {{ message|nl2br }}
    </p>

    <p>Cordialement,<br>
    L'équipe d'organisation de Dawn</p>
{% endblock %} 